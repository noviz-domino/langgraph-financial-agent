# 이 파일을 복사해서 .env를 만든다:  cp .env.example .env
# .env는 git에 올라가지 않는다. 실제 키는 .env에만 넣는다.

# ── 방법 1: 이 프로젝트의 .env에 키를 직접 넣기 (다른 컴퓨터·채점자는 이 방법) ──
GEMINI_API_KEY=your-api-key-here

# ── 방법 2: 여러 프로젝트가 함께 쓰는 키 파일을 가리키기 ──
# 키가 들어 있는 다른 .env 파일의 절대경로를 적는다. 방법 1과 함께 쓰면 방법 1의 값이 우선한다
# SHARED_ENV_FILE=C:\path\to\shared\.env

# ── LangSmith 추적 (선택) — 키가 있을 때만 true로 바꾼다 (가짜 키로 켜 두면 호출마다 오류 로그가 난다) ──
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=langgraph-financial-agent
